# Unit do painel web.
[Unit]
Description=Painel web do Open DHCP Server
After=network-online.target

[Service]
ExecStart=/usr/bin/opendhcp-panel serve -c /etc/opendhcp-panel/panel.toml
# Usuário próprio, sem root. Grava o .ini e o estado dos leases (grupo opendhcp-panel), a própria
# configuração e os próprios dados; iniciar/parar o servidor DHCP e a desinstalação passam pela
# regra do polkit 50-opendhcp-panel.rules.
User=opendhcp-panel
Group=opendhcp-panel
StateDirectory=opendhcp-panel
StateDirectoryMode=0700
UMask=0077
Restart=on-failure

CapabilityBoundingSet=
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=-/opt/opendhcp -/etc/opendhcp-panel -/var/lib/opendhcp -/var/lib/opendhcp-panel
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
