# Unit do servidor DHCP (o painel controla esta unit).
[Unit]
Description=Open DHCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
# Estado dos leases fora do /tmp (lá outro usuário local poderia plantar um link ou arquivo).
ExecStart=/opt/opendhcp/opendhcpd -i /opt/opendhcp/opendhcp.ini -s /var/lib/opendhcp/opendhcp.state -l /opt/opendhcp/log/opendhcp%%Y%%m%%d.log
# Pasta do estado só do root; o arquivo de estado com o grupo do painel, que o lê e, ao liberar
# um lease, o regrava ("+": roda fora do isolamento, que tira o poder de trocar o grupo).
ExecStartPre=+/bin/sh -c 'install -d -m 0750 /var/lib/opendhcp && chmod 0750 /var/lib/opendhcp && touch /var/lib/opendhcp/opendhcp.state && if getent group opendhcp-panel >/dev/null; then chgrp opendhcp-panel /var/lib/opendhcp /var/lib/opendhcp/opendhcp.state && chmod 0660 /var/lib/opendhcp/opendhcp.state; fi'
Restart=on-failure

# O opendhcpd exige uid 0, mas só precisa abrir a porta 67: o resto dos poderes de root fica fora.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_BROADCAST CAP_NET_RAW
NoNewPrivileges=true
UMask=0022
ProtectSystem=strict
ReadWritePaths=-/opt/opendhcp -/var/lib/opendhcp
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
